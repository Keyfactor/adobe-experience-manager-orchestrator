<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UO 11 = net6.0, UO 12 = net8.0, net10.0 for forward support -->
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Keyfactor.Extensions.Orchestrator.AEMCM</RootNamespace>
    <AssemblyName>AEMCM.Orchestrator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Copyright>Copyright © Keyfactor</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keyfactor Universal Orchestrator SDK (GitHub Packages feed; see ../nuget.config).
         Versions match the current reference extensions; pin to your target UO/Command release. -->
    <PackageReference Include="Keyfactor.Orchestrators.IOrchestratorJobExtensions" Version="1.0.0" />
    <PackageReference Include="Keyfactor.Orchestrators.Common" Version="3.3.0" />
    <!-- Keyfactor.Logging 1.3.0 ships only net472 and net8.0 assets. On net6.0 NuGet falls
         back to the net472 build (NU1701); suppress that warning here. -->
    <PackageReference Include="Keyfactor.Logging" Version="1.3.0" NoWarn="NU1701" />
    <PackageReference Include="Keyfactor.Platform.IPAMProvider" Version="1.0.0" />
    <!-- JSON via System.Text.Json (in-box, no package).
         BouncyCastle parses PKCS#12 and exports PKCS#8 without relying on the OS key store /
         Windows CNG export policy (which blocks key export on .NET 8). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <!-- net6.0 has no matching Keyfactor.Logging asset and falls back to the net472 build,
       which references the .NET Framework flavor of Logging.Abstractions (assembly ver
       8.0.0.1). The net6.0 asset of 8.0.x is stuck at assembly ver 8.0.0.0, so no 8.0.x
       pin clears CS1705; only a 9.x build (assembly ver 9.0.0.0) is high enough.
       See https://github.com/dotnet/runtime/issues/109044 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AEMCM.Orchestrator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both manifests must land in the build output (deployed to extensions/<name>/). -->
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="..\integration-manifest.json" Link="integration-manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
