<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Keyfactor packages are hosted on GitHub Packages. Authenticate with a GitHub
         Personal Access Token that has the read:packages scope. Register the credential
         once with "dotnet nuget add source" (see README.md), or fill in the
         packageSourceCredentials block below. -->
    <add key="keyfactor-github" value="https://nuget.pkg.github.com/Keyfactor/index.json" />
  </packageSources>

  <!-- Uncomment and supply credentials to restore Keyfactor packages.
  <packageSourceCredentials>
    <keyfactor-github>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </keyfactor-github>
  </packageSourceCredentials>
  -->
</configuration>
